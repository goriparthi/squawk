<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Focusing a terminal pane is an AppleScript call into another app, which
         the hardened runtime blocks without this. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    <!-- Listening to what the machine is playing goes through a Core Audio
         process tap, which the hardened runtime treats as audio input. Without
         this the tap is created happily and hands back silence forever. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
